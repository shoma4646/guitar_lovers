{
  "expo": {
    "name": "Guitar Lovers",
    "slug": "guitar-lovers",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "guitar-lovers",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fff8f7"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "jp.shoma.guitarlovers",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "jp.shoma.guitarlovers",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fff8f7"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "チューナーでギターの音を拾うためにマイクを使用します。音声は端末内で処理され、保存や送信はされません。",
          "iosBackgroundMode": false,
          "androidPermissions": ["android.permission.RECORD_AUDIO"],
          "androidForegroundService": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ae3026"
        }
      ]
    ]
  }
}
